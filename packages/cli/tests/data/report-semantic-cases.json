[
  {
    "name": "unknown section",
    "patch": [
      {
        "op": "replace",
        "path": "/items/0/section",
        "value": "weather"
      }
    ],
    "expect": "unknown section 'weather'"
  },
  {
    "name": "unknown item type",
    "patch": [
      {
        "op": "replace",
        "path": "/items/0/type",
        "value": "poem"
      }
    ],
    "expect": "unknown item type 'poem'"
  },
  {
    "name": "detail fails type schema",
    "patch": [
      {
        "op": "remove",
        "path": "/items/0/detail/who"
      }
    ],
    "expect": "items/0/detail"
  },
  {
    "name": "duplicate item id",
    "patch": [
      {
        "op": "replace",
        "path": "/items/1/id",
        "value": "example-co-launch"
      }
    ],
    "expect": "duplicate item id 'example-co-launch'"
  },
  {
    "name": "dangling tldr reference",
    "patch": [
      {
        "op": "replace",
        "path": "/tldr/0/item_id",
        "value": "missing-item"
      }
    ],
    "expect": "unknown item 'missing-item'"
  },
  {
    "name": "confirmed without primary source",
    "patch": [
      {
        "op": "replace",
        "path": "/items/0/sources/0/kind",
        "value": "secondary"
      }
    ],
    "expect": "primary"
  },
  {
    "name": "fact points past sources",
    "patch": [
      {
        "op": "replace",
        "path": "/items/0/facts/0/source_ref",
        "value": 5
      }
    ],
    "expect": "source_ref"
  },
  {
    "name": "rumor in items",
    "patch": [
      {
        "op": "replace",
        "path": "/items/0/confidence",
        "value": "rumor"
      }
    ],
    "expect": "rumors never go in items"
  },
  {
    "name": "reported in items while routed to signals",
    "patch": [
      {
        "op": "replace",
        "path": "/items/0/confidence",
        "value": "reported"
      }
    ],
    "expect": "reported items go in signals"
  },
  {
    "name": "remote chart data",
    "patch": [
      {
        "op": "add",
        "path": "/items/0/visuals/-",
        "value": {
          "kind": "vega-lite",
          "id": "remote-chart",
          "title": "Remote",
          "alt": "Remote data chart",
          "source_note": "Example",
          "spec": {
            "layer": [
              {
                "mark": "bar",
                "data": {
                  "url": "https://example.org/data.csv"
                }
              }
            ]
          }
        }
      }
    ],
    "expect": "data/url"
  },
  {
    "name": "table row width",
    "patch": [
      {
        "op": "add",
        "path": "/items/0/visuals/0/rows/-",
        "value": ["EU", "extra"]
      }
    ],
    "expect": "2 cells"
  },
  {
    "name": "undeclared featured slot",
    "patch": [
      {
        "op": "add",
        "path": "/featured/editor_pick",
        "value": "example-co-launch"
      }
    ],
    "expect": "no section group declares"
  },
  {
    "name": "featured item of the wrong type",
    "patch": [
      {
        "op": "replace",
        "path": "/featured/paper_of_the_day",
        "value": "example-co-launch"
      }
    ],
    "expect": "has type 'industry'"
  },
  {
    "name": "duplicate visual id",
    "patch": [
      {
        "op": "add",
        "path": "/front_page/-",
        "value": {
          "kind": "table",
          "id": "regions-table",
          "title": "Again",
          "alt": "Again",
          "source_note": "Example",
          "columns": ["A"],
          "rows": []
        }
      }
    ],
    "expect": "duplicate visual id 'regions-table'"
  },
  {
    "name": "visual block is not one of the item type's blocks",
    "patch": [
      {
        "op": "add",
        "path": "/items/0/visuals/0/block",
        "value": "benchmarks"
      }
    ],
    "expect": "block 'benchmarks' is not one of the 'industry' blocks"
  },
  {
    "name": "front-page visual names a block",
    "patch": [
      {
        "op": "add",
        "path": "/front_page/-",
        "value": {
          "kind": "table",
          "id": "front-table",
          "title": "Front",
          "alt": "Front table",
          "source_note": "Report",
          "block": "timeline",
          "columns": ["A"],
          "rows": [["x"]]
        }
      }
    ],
    "expect": "front-page visuals are not in an item"
  },
  {
    "name": "dashboard tile wider than the dashboard",
    "patch": [
      {
        "op": "add",
        "path": "/front_page/-",
        "value": {
          "kind": "dashboard",
          "id": "board",
          "title": "Board",
          "alt": "Board",
          "source_note": "Report",
          "columns": 2,
          "tiles": [
            {
              "tile": "stat",
              "span": 3,
              "label": "Items",
              "value": 3
            }
          ]
        }
      }
    ],
    "expect": "span 3 is wider than the dashboard's 2 columns"
  },
  {
    "name": "duplicate visual id inside a dashboard",
    "patch": [
      {
        "op": "add",
        "path": "/front_page/-",
        "value": {
          "kind": "dashboard",
          "id": "board",
          "title": "Board",
          "alt": "Board",
          "source_note": "Report",
          "columns": 1,
          "tiles": [
            {
              "tile": "visual",
              "visual": {
                "kind": "table",
                "id": "regions-table",
                "title": "Again",
                "alt": "Again",
                "source_note": "Report",
                "columns": ["A"],
                "rows": [["x"]]
              }
            }
          ]
        }
      }
    ],
    "expect": "duplicate visual id 'regions-table'"
  },
  {
    "name": "table row width inside a dashboard",
    "patch": [
      {
        "op": "add",
        "path": "/front_page/-",
        "value": {
          "kind": "dashboard",
          "id": "board",
          "title": "Board",
          "alt": "Board",
          "source_note": "Report",
          "columns": 1,
          "tiles": [
            {
              "tile": "visual",
              "visual": {
                "kind": "table",
                "id": "tile-table",
                "title": "T",
                "alt": "T",
                "source_note": "Report",
                "columns": ["A"],
                "rows": [["x", "y"]]
              }
            }
          ]
        }
      }
    ],
    "expect": "2 cells, expected 1"
  },
  {
    "name": "remote chart data inside a dashboard",
    "patch": [
      {
        "op": "add",
        "path": "/front_page/-",
        "value": {
          "kind": "dashboard",
          "id": "board",
          "title": "Board",
          "alt": "Board",
          "source_note": "Report",
          "columns": 1,
          "tiles": [
            {
              "tile": "visual",
              "visual": {
                "kind": "vega-lite",
                "id": "tile-chart",
                "title": "C",
                "alt": "C",
                "source_note": "Report",
                "spec": {
                  "data": {
                    "url": "https://example.org/data.json"
                  },
                  "mark": "bar"
                }
              }
            }
          ]
        }
      }
    ],
    "expect": "remote chart data"
  },
  {
    "name": "visual inside a dashboard names a block",
    "patch": [
      {
        "op": "add",
        "path": "/front_page/-",
        "value": {
          "kind": "dashboard",
          "id": "board",
          "title": "Board",
          "alt": "Board",
          "source_note": "Report",
          "columns": 1,
          "tiles": [
            {
              "tile": "visual",
              "visual": {
                "kind": "table",
                "id": "tile-table",
                "title": "T",
                "alt": "T",
                "source_note": "Report",
                "block": "timeline",
                "columns": ["A"],
                "rows": [["x"]]
              }
            }
          ]
        }
      }
    ],
    "expect": "visuals inside a dashboard cannot name a block"
  },
  {
    "name": "remote data in a Vega data array",
    "patch": [
      {
        "op": "add",
        "path": "/items/0/visuals/-",
        "value": {
          "kind": "vega-lite",
          "id": "remote-array",
          "title": "Remote",
          "alt": "Remote data chart",
          "source_note": "Example",
          "spec": {
            "mark": "bar",
            "data": [{ "name": "table", "url": "https://example.org/data.json" }]
          }
        }
      }
    ],
    "expect": "spec/data/0/url"
  },
  {
    "name": "remote image in a chart",
    "patch": [
      {
        "op": "add",
        "path": "/items/0/visuals/-",
        "value": {
          "kind": "vega-lite",
          "id": "remote-image",
          "title": "Remote",
          "alt": "Remote image chart",
          "source_note": "Example",
          "spec": {
            "mark": "image",
            "data": { "values": [{ "a": 1 }] },
            "encoding": { "url": { "value": "https://example.org/image.png" } }
          }
        }
      }
    ],
    "expect": "spec/encoding/url"
  },
  {
    "name": "embed options in chart usermeta",
    "patch": [
      {
        "op": "add",
        "path": "/items/0/visuals/-",
        "value": {
          "kind": "vega-lite",
          "id": "usermeta-chart",
          "title": "Usermeta",
          "alt": "Chart with embed options",
          "source_note": "Example",
          "spec": {
            "mark": "bar",
            "data": { "values": [{ "a": 1 }] },
            "usermeta": { "embedOptions": { "patch": "https://example.org/patch.json" } }
          }
        }
      }
    ],
    "expect": "spec/usermeta"
  },
  {
    "name": "a Vega spec in a vega-lite visual",
    "patch": [
      {
        "op": "add",
        "path": "/items/0/visuals/-",
        "value": {
          "kind": "vega-lite",
          "id": "vega-chart",
          "title": "Vega",
          "alt": "A full Vega spec",
          "source_note": "Example",
          "spec": {
            "$schema": "https://vega.github.io/schema/vega/v6.json",
            "data": [{ "name": "table", "values": [] }]
          }
        }
      }
    ],
    "expect": "spec/$schema"
  },
  {
    "name": "notes for an unknown section",
    "patch": [
      {
        "op": "add",
        "path": "/section_notes/nope",
        "value": [{ "title": "Lost", "text": "No section shows this note." }]
      }
    ],
    "expect": "section_notes/nope: unknown section"
  },
  {
    "name": "note names a group its section lacks",
    "patch": [
      {
        "op": "add",
        "path": "/section_notes/models",
        "value": [{ "group": "top_papers", "title": "Stray", "text": "Models has no groups." }]
      }
    ],
    "expect": "section_notes/models/0/group"
  },
  {
    "name": "window time zone that is not an IANA name",
    "patch": [{ "op": "replace", "path": "/meta/window/tz", "value": "UTC+3" }],
    "expect": "meta/window/tz: unknown time zone 'UTC+3'"
  }
]
