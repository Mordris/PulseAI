{
  "name": "@pulseai/site",
  "version": "0.1.0",
  "private": true,
  "description": "PulseAI report site: the Astro frame, per-type deep-dives, and generative visuals",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "build:demo": "node scripts/pulse-site.ts build --instance ../../examples",
    "dev:demo": "node scripts/pulse-site.ts dev --instance ../../examples",
    "preview:demo": "node scripts/pulse-site.ts preview --instance ../../examples",
    "check:demo": "node scripts/pulse-site.ts check --instance ../../examples",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@astrojs/check": "^0.9.10",
    "@astrojs/sitemap": "^3.7.4",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@fontsource-variable/newsreader": "^5.3.0",
    "@fontsource-variable/source-serif-4": "^5.3.1",
    "@pulseai/contracts": "workspace:*",
    "@pulseai/tokens": "workspace:*",
    "astro": "^7.3.8",
    "astro-pagefind": "^2.0.1",
    "mermaid": "^12.1.0",
    "vega": "^6.4.0",
    "vega-embed": "^7.3.0",
    "vega-lite": "^6.5.0",
    "zod": "^4.6.6"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "typescript": "^6.0.3",
    "vitest": "^5.0.3",
    "yaml": "^2.9.1"
  }
}
