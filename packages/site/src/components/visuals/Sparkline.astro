---
import type { RenderContext } from "../../lib/render.ts";
import { sparkline } from "../../lib/sparkline.ts";

interface Props {
  ctx: RenderContext;
  series: readonly number[];
}

// A decorative trend: the value and delta next to it carry the meaning for every reader.
const { ctx, series } = Astro.props;
const width = ctx.tokenNumber("chart.sparkline.width");
const height = ctx.tokenNumber("chart.sparkline.height");
const line = sparkline(series, width, height, ctx.tokenNumber("chart.sparkline.padding"));
---

{line && (
  <svg class="sparkline" viewBox={`0 0 ${width} ${height}`} width={width} height={height} aria-hidden="true" focusable="false">
    <polyline points={line.points} />
    <circle cx={line.last.x} cy={line.last.y} r={ctx.tokenNumber("chart.sparkline.point_radius")} />
  </svg>
)}

<style>
  .sparkline {
    display: block;
    overflow: visible;
  }

  polyline {
    fill: none;
    stroke: var(--pulse-color-accent-default);
    stroke-width: var(--pulse-chart-line-width);
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  circle {
    fill: var(--pulse-color-accent-default);
  }
</style>
