{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:pulseai:schema:github-repository",
  "title": "RepositorySettings",
  "description": "GitHub repository settings applied by scripts/github/apply_repo_settings.py.",
  "type": "object",
  "additionalProperties": false,
  "required": ["description", "homepage", "topics", "features", "merge", "security", "ruleset"],
  "properties": {
    "description": { "type": "string", "minLength": 1, "maxLength": 350 },
    "homepage": { "type": ["string", "null"], "format": "uri", "pattern": "^https://" },
    "topics": {
      "type": "array",
      "maxItems": 20,
      "uniqueItems": true,
      "items": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,49}$" }
    },
    "features": {
      "type": "object",
      "additionalProperties": false,
      "required": ["issues", "discussions", "wiki", "projects"],
      "properties": {
        "issues": { "type": "boolean" },
        "discussions": { "type": "boolean" },
        "wiki": { "type": "boolean" },
        "projects": { "type": "boolean" }
      }
    },
    "merge": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "squash",
        "merge_commit",
        "rebase",
        "squash_title",
        "squash_message",
        "delete_branch_on_merge",
        "auto_merge"
      ],
      "properties": {
        "squash": { "type": "boolean" },
        "merge_commit": { "type": "boolean" },
        "rebase": { "type": "boolean" },
        "squash_title": { "enum": ["PR_TITLE", "COMMIT_OR_PR_TITLE"] },
        "squash_message": { "enum": ["PR_BODY", "COMMIT_MESSAGES", "BLANK"] },
        "delete_branch_on_merge": { "type": "boolean" },
        "auto_merge": { "type": "boolean" }
      }
    },
    "security": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "secret_scanning",
        "push_protection",
        "private_vulnerability_reporting",
        "dependabot_alerts"
      ],
      "properties": {
        "secret_scanning": { "type": "boolean" },
        "push_protection": { "type": "boolean" },
        "private_vulnerability_reporting": { "type": "boolean" },
        "dependabot_alerts": { "type": "boolean" }
      }
    },
    "ruleset": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "required_approvals",
        "required_checks",
        "linear_history",
        "dismiss_stale_reviews_on_push",
        "required_review_thread_resolution",
        "require_code_owner_review",
        "require_last_push_approval",
        "strict_required_status_checks_policy"
      ],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "required_approvals": { "type": "integer", "minimum": 0, "maximum": 6 },
        "required_checks": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "linear_history": { "type": "boolean" },
        "dismiss_stale_reviews_on_push": { "type": "boolean" },
        "required_review_thread_resolution": { "type": "boolean" },
        "require_code_owner_review": { "type": "boolean" },
        "require_last_push_approval": { "type": "boolean" },
        "strict_required_status_checks_policy": { "type": "boolean" }
      }
    }
  }
}
