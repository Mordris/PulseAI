{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:pulseai:schema:sources",
  "title": "SourcesRegistry",
  "description": "Research sources (sources/registry/*.yaml). Each source is read by the generic collector, an MCP tool, or web search.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "sources"],
  "properties": {
    "schema_version": { "const": 1 },
    "sources": { "type": "array", "items": { "$ref": "#/$defs/source" } }
  },
  "$defs": {
    "id": { "type": "string", "pattern": "^[a-z0-9]+(?:[_-][a-z0-9]+)*$" },
    "text": { "type": "string", "minLength": 1 },
    "url": { "type": "string", "format": "uri", "pattern": "^https://" },
    "urlTemplate": { "type": "string", "pattern": "^https://\\S+$" },
    "jmespath": { "type": "string", "minLength": 1 },
    "pathGlob": { "type": "string", "pattern": "^/\\S*$" },
    "envName": { "type": "string", "pattern": "^[A-Z][A-Z0-9_]*$" },
    "tier": { "enum": ["T1", "T1-data", "T2", "T3"] },
    "trust": { "type": "integer", "minimum": 1, "maximum": 5 },
    "sectionIds": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/id" }
    },
    "source": {
      "oneOf": [
        { "$ref": "#/$defs/collectorSource" },
        { "$ref": "#/$defs/mcpSource" },
        { "$ref": "#/$defs/searchSource" }
      ]
    },
    "collectorSource": {
      "title": "CollectorSource",
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "tier", "sections", "trust", "enabled", "via", "collector"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "name": { "$ref": "#/$defs/text" },
        "homepage": { "$ref": "#/$defs/url" },
        "tier": { "$ref": "#/$defs/tier" },
        "sections": { "$ref": "#/$defs/sectionIds" },
        "trust": { "$ref": "#/$defs/trust" },
        "enabled": { "type": "boolean" },
        "notes": { "type": "string" },
        "changelog": {
          "type": "boolean",
          "description": "Keep undated items (the source is a changelog or release list). Default false."
        },
        "via": { "const": "collector" },
        "collector": { "$ref": "#/$defs/collector" }
      }
    },
    "mcpSource": {
      "title": "McpSource",
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "tier", "sections", "trust", "enabled", "via", "mcp"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "name": { "$ref": "#/$defs/text" },
        "homepage": { "$ref": "#/$defs/url" },
        "tier": { "$ref": "#/$defs/tier" },
        "sections": { "$ref": "#/$defs/sectionIds" },
        "trust": { "$ref": "#/$defs/trust" },
        "enabled": { "type": "boolean" },
        "notes": { "type": "string" },
        "via": { "const": "mcp" },
        "mcp": {
          "title": "McpCall",
          "type": "object",
          "additionalProperties": false,
          "required": ["server", "tool"],
          "properties": {
            "server": { "$ref": "#/$defs/id" },
            "tool": { "type": "string", "pattern": "^[A-Za-z0-9_.-]+$" },
            "args": { "type": "object" }
          }
        }
      }
    },
    "searchSource": {
      "title": "SearchSource",
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "tier", "sections", "trust", "enabled", "via", "search"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "name": { "$ref": "#/$defs/text" },
        "homepage": { "$ref": "#/$defs/url" },
        "tier": { "$ref": "#/$defs/tier" },
        "sections": { "$ref": "#/$defs/sectionIds" },
        "trust": { "$ref": "#/$defs/trust" },
        "enabled": { "type": "boolean" },
        "notes": { "type": "string" },
        "via": { "const": "search" },
        "search": {
          "title": "SearchSpec",
          "type": "object",
          "additionalProperties": false,
          "required": ["queries"],
          "properties": {
            "queries": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/text" } },
            "domains": {
              "type": "array",
              "items": { "type": "string", "pattern": "^[a-z0-9.-]+\\.[a-z]{2,}$" }
            },
            "pages": {
              "type": "array",
              "uniqueItems": true,
              "items": { "$ref": "#/$defs/url" },
              "description": "Pages an agent should fetch and read directly, for labs with neither a feed nor a sitemap."
            }
          }
        }
      }
    },
    "collector": {
      "oneOf": [
        { "$ref": "#/$defs/feedCollector" },
        { "$ref": "#/$defs/jsonCollector" },
        { "$ref": "#/$defs/snapshotCollector" },
        { "$ref": "#/$defs/sitemapCollector" }
      ]
    },
    "http": {
      "title": "HttpOptions",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "auth_header": { "type": "string", "minLength": 1 },
        "auth_env": { "$ref": "#/$defs/envName" },
        "auth_prefix": { "type": "string" },
        "auth_optional": {
          "type": "boolean",
          "description": "Send the request without auth when auth_env is unset, instead of failing. Default false."
        },
        "timeout_seconds": { "type": "number", "exclusiveMinimum": 0, "maximum": 300 },
        "rate_limit_per_minute": { "type": "integer", "minimum": 1 },
        "retries": { "type": "integer", "minimum": 0, "maximum": 10 }
      }
    },
    "fieldMap": {
      "title": "FieldMap",
      "type": "object",
      "additionalProperties": false,
      "required": ["title", "url"],
      "properties": {
        "id": { "$ref": "#/$defs/jmespath" },
        "title": { "$ref": "#/$defs/jmespath" },
        "url": { "$ref": "#/$defs/jmespath" },
        "published": { "$ref": "#/$defs/jmespath" },
        "summary": { "$ref": "#/$defs/jmespath" },
        "signal": { "$ref": "#/$defs/jmespath" },
        "extra": {
          "type": "object",
          "propertyNames": { "$ref": "#/$defs/id" },
          "additionalProperties": { "$ref": "#/$defs/jmespath" },
          "description": "More values to keep on each item, as output key to JMESPath."
        }
      }
    },
    "feedCollector": {
      "title": "FeedCollector",
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "url"],
      "properties": {
        "kind": { "enum": ["rss", "atom"] },
        "url": { "$ref": "#/$defs/urlTemplate" },
        "fields": { "$ref": "#/$defs/fieldMap" },
        "http": { "$ref": "#/$defs/http" }
      }
    },
    "jsonCollector": {
      "title": "JsonCollector",
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "url", "items", "fields"],
      "properties": {
        "kind": { "const": "json" },
        "url": { "$ref": "#/$defs/urlTemplate" },
        "items": { "$ref": "#/$defs/jmespath" },
        "fields": { "$ref": "#/$defs/fieldMap" },
        "http": { "$ref": "#/$defs/http" }
      }
    },
    "snapshotCollector": {
      "title": "SnapshotCollector",
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "url", "items", "key", "fields"],
      "properties": {
        "kind": { "const": "json-snapshot-diff" },
        "url": { "$ref": "#/$defs/urlTemplate" },
        "items": { "$ref": "#/$defs/jmespath" },
        "key": { "$ref": "#/$defs/jmespath" },
        "track": { "type": "array", "items": { "$ref": "#/$defs/jmespath" } },
        "fields": { "$ref": "#/$defs/fieldMap" },
        "http": { "$ref": "#/$defs/http" }
      }
    },
    "sitemapCollector": {
      "title": "SitemapCollector",
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "url", "include"],
      "properties": {
        "kind": { "const": "sitemap" },
        "url": { "$ref": "#/$defs/urlTemplate" },
        "include": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/pathGlob" },
          "description": "URL path globs to keep, each starting with /."
        },
        "exclude": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/pathGlob" },
          "description": "URL path globs to drop from the included set."
        },
        "meta_fetch_limit": {
          "type": "integer",
          "minimum": 1,
          "description": "Most pages read per run; defaults to collect.meta_fetch_limit."
        },
        "http": { "$ref": "#/$defs/http" }
      }
    }
  }
}
