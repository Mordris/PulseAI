{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:pulseai:schema:item-types:release",
  "title": "ReleaseDetail",
  "type": "object",
  "additionalProperties": false,
  "required": ["product", "version", "changelog", "verdict"],
  "properties": {
    "product": { "type": "string", "minLength": 1 },
    "version": { "type": "string", "minLength": 1 },
    "previous_version": { "type": "string", "minLength": 1 },
    "changelog": {
      "type": "array",
      "minItems": 1,
      "items": {
        "title": "ChangelogEntry",
        "type": "object",
        "additionalProperties": false,
        "required": ["tag", "text"],
        "properties": {
          "tag": {
            "enum": ["new", "fix", "breaking", "perf", "deprecation", "security"],
            "x-pulse-label": "changelog",
            "x-pulse-tone": "color.changelog"
          },
          "text": { "type": "string", "minLength": 1, "maxLength": 300 }
        }
      }
    },
    "verdict": {
      "enum": ["adopt", "trial", "assess", "hold"],
      "x-pulse-label": "rings",
      "x-pulse-tone": "color.ring"
    },
    "snippet": { "type": "string", "minLength": 1 },
    "migration_notes": { "type": "string", "minLength": 1 }
  }
}
