{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:pulseai:schema:sections",
  "title": "SectionsRegistry",
  "description": "Report sections (taxonomy/sections.yaml).",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "sections"],
  "properties": {
    "schema_version": { "const": 1 },
    "sections": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/section" } }
  },
  "$defs": {
    "id": { "type": "string", "pattern": "^[a-z0-9]+(?:[_-][a-z0-9]+)*$" },
    "localeKey": { "type": "string", "pattern": "^[a-z0-9_]+(?:\\.[a-z0-9_-]+)+$" },
    "section": {
      "title": "Section",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "label",
        "color_token",
        "order",
        "rubric",
        "default_item_types",
        "researcher_brief",
        "groups"
      ],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "label": { "$ref": "#/$defs/localeKey" },
        "color_token": { "type": "string", "pattern": "^[a-z0-9]+(?:[.-][a-z0-9]+)*$" },
        "order": { "type": "integer", "minimum": 0 },
        "rubric": {
          "type": "array",
          "minItems": 5,
          "maxItems": 5,
          "items": { "type": "string", "minLength": 1 },
          "description": "Impact definitions for scores 1 to 5, in order."
        },
        "default_item_types": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/id" }
        },
        "researcher_brief": { "type": "string", "minLength": 1 },
        "groups": { "type": "array", "items": { "$ref": "#/$defs/group" } }
      }
    },
    "group": {
      "title": "SectionGroup",
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "label", "match"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "label": { "$ref": "#/$defs/localeKey" },
        "match": {
          "title": "GroupMatch",
          "type": "object",
          "additionalProperties": false,
          "minProperties": 1,
          "properties": {
            "featured": { "$ref": "#/$defs/id" },
            "types": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": { "$ref": "#/$defs/id" }
            },
            "depth": { "enum": ["deep", "brief"] }
          }
        }
      }
    }
  }
}
