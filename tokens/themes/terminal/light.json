{
  "color": {
    "surface": {
      "$type": "color",
      "page": {
        "$value": "#f4f7f4"
      },
      "raised": {
        "$value": "#ffffff"
      },
      "sunken": {
        "$value": "#e9eee9"
      }
    },
    "text": {
      "$type": "color",
      "primary": {
        "$value": "#0f1a12",
        "$extensions": {
          "org.pulseai": {
            "contrast_against": [
              "color.surface.page",
              "color.surface.raised",
              "color.surface.sunken"
            ]
          }
        }
      },
      "secondary": {
        "$value": "#3b4a3f",
        "$extensions": {
          "org.pulseai": {
            "contrast_against": [
              "color.surface.page",
              "color.surface.raised",
              "color.surface.sunken"
            ]
          }
        }
      },
      "muted": {
        "$value": "#55645a",
        "$extensions": {
          "org.pulseai": {
            "contrast_against": [
              "color.surface.page",
              "color.surface.raised",
              "color.surface.sunken"
            ]
          }
        }
      }
    },
    "border": {
      "$type": "color",
      "subtle": {
        "$value": "#d5ded6"
      },
      "strong": {
        "$value": "#b3c1b5"
      }
    },
    "accent": {
      "$type": "color",
      "default": {
        "$value": "#0b6e38",
        "$extensions": {
          "org.pulseai": {
            "override": "accent",
            "contrast_against": [
              "color.surface.page",
              "color.surface.raised",
              "color.surface.sunken"
            ]
          }
        }
      }
    },
    "focus": {
      "$type": "color",
      "ring": {
        "$value": "{palette.blue.450}"
      }
    },
    "chart": {
      "$type": "color",
      "grid": {
        "$value": "#d5ded6"
      },
      "axis": {
        "$value": "#b3c1b5"
      },
      "label": {
        "$value": "{color.text.secondary}"
      },
      "surface": {
        "$value": "{color.surface.raised}"
      }
    }
  }
}
