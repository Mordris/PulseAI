{
  "$schema": "https://raw.githubusercontent.com/googleapis/release-please/main/schemas/config.json",
  "include-component-in-tag": true,
  "separate-pull-requests": false,
  "changelog-sections": [
    { "type": "feat", "section": "Features" },
    { "type": "fix", "section": "Bug fixes" },
    { "type": "perf", "section": "Performance" },
    { "type": "revert", "section": "Reverts" },
    { "type": "docs", "section": "Documentation" },
    { "type": "refactor", "section": "Refactoring" },
    { "type": "build", "section": "Build system" },
    { "type": "ci", "section": "CI", "hidden": true },
    { "type": "test", "section": "Tests", "hidden": true },
    { "type": "chore", "section": "Miscellaneous", "hidden": true }
  ],
  "plugins": [
    {
      "type": "linked-versions",
      "groupName": "engine",
      "components": ["cli", "contracts", "tokens", "site"]
    }
  ],
  "packages": {
    "packages/cli": {
      "release-type": "python",
      "package-name": "pulseai",
      "component": "cli",
      "extra-files": [
        { "type": "yaml", "path": "/defaults/pulse.config.yaml", "jsonpath": "$.engine.version" },
        {
          "type": "json",
          "path": "/plugins/pulse/.claude-plugin/plugin.json",
          "jsonpath": "$.version"
        },
        {
          "type": "toml",
          "path": "/uv.lock",
          "jsonpath": "$.package[?(@.name.value=='pulseai')].version"
        },
        { "type": "yaml", "path": "/CITATION.cff", "jsonpath": "$.version" }
      ]
    },
    "packages/contracts": {
      "release-type": "node",
      "package-name": "@pulseai/contracts",
      "component": "contracts"
    },
    "packages/tokens": {
      "release-type": "node",
      "package-name": "@pulseai/tokens",
      "component": "tokens"
    },
    "packages/site": {
      "release-type": "node",
      "package-name": "@pulseai/site",
      "component": "site"
    }
  }
}
